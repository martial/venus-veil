{
  "name": "venus-veil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A translucent veil in wind, shaped by the depth map of a prehistoric Venus.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5190 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "projector": "sh scripts/projector.sh",
    "projector:setup": "sh scripts/setup-projector.sh",
    "test:server": ".venv-projector/bin/python -m unittest discover -s server -p \"test_*.py\"",
    "to-mp4": "sh scripts/to-mp4.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "alea": "^1.0.1",
    "mediabunny": "^1.56.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
